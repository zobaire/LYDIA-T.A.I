# ============================================================
#  LYDIA T.A.I — line-ending + binary policy
#  Single source of truth. core.autocrlf must be FALSE in this repo,
#  otherwise git status reports every file as modified for no reason.
# ============================================================

# Default: let git detect, store as LF in the repo
* text=auto eol=lf

# --- Windows launchers must keep CRLF or they can misbehave ---
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# --- Explicit text types ---
*.py     text
*.js     text
*.mjs    text
*.html   text
*.css    text
*.json   text
*.yaml   text
*.yml    text
*.md     text
*.txt    text
*.pine   text
*.env    text
*.example text

# --- Binary: never diff, never normalize ---
*.zip    binary
*.7z     binary
*.rar    binary
*.exe    binary
*.dll    binary
*.pyd    binary
*.so     binary
*.onnx   binary
*.pdb    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.bmp    binary
*.ico    binary
*.webp   binary
*.mp3    binary
*.wav    binary
*.ogg    binary
*.mp4    binary
*.fbx    binary
*.blend  binary
*.scn    binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.db     binary
*.sqlite binary
*.sqlite3 binary
*.pdf    binary

# --- Vendor bundles: keep them out of diffs and language stats ---
ui/vendor/*  linguist-vendored
bin/*        linguist-vendored
